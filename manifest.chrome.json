{
  "manifest_version": 3,
  "name": "GTab",
  "version": "1.0",
  "description": "Новая вкладка в тёмной теме с акцентом Windows, анимациями Google, Яндекс и DuckDuckGo и умным поиском.",
  "author": "JunDevX",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GTab — настройки",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "minimum_chrome_version": "102"
}
