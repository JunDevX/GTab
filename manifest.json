{
  "manifest_version": 3,
  "name": "GTab",
  "version": "1.1",
  "description": "\u041d\u043e\u0432\u0430\u044f \u0432\u043a\u043b\u0430\u0434\u043a\u0430 \u0432 \u0442\u0451\u043c\u043d\u043e\u0439 \u0442\u0435\u043c\u0435 \u0441 \u0430\u043a\u0446\u0435\u043d\u0442\u043e\u043c Windows, \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044f\u043c\u0438 Google, \u042f\u043d\u0434\u0435\u043a\u0441 \u0438 DuckDuckGo \u0438 \u0443\u043c\u043d\u044b\u043c \u043f\u043e\u0438\u0441\u043a\u043e\u043c.",
  "author": "JunDevX",
  "browser_specific_settings": {
    "gecko": {
      "id": "gtab@jundevx",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GTab \u2014 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage"
  ]
}